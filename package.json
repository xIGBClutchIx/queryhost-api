{
  "name": "@queryhost/api",
  "version": "0.0.0",
  "private": true,
  "description": "Portable hosted API for QueryHost game server queries.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@12.0.2",
  "scripts": {
    "build": "node scripts/clean-dist.mjs && node node_modules/@typescript/native/bin/tsc --project tsconfig.build.json",
    "dev": "node --watch src/main.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --type-aware --report-unused-disable-directives src test",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --project tsconfig.check.json",
    "verify": "npm run format:check && npm run build && npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "queryhost": "1.7.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.9",
    "vitest": "^5.0.3"
  }
}
